# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Supabase) ---
# Find these in your Supabase project: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, NEVER expose this to the frontend/browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Anon/public key — required at startup, used for RLS-enforced user client (config/supabase.js)
SUPABASE_ANON_KEY=your_anon_key

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- AI Layer (Ollama) ---
# Local dev: run `ollama serve` and `ollama pull llama3`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# In prod, point this at your GPU box / cloud Ollama endpoint instead

# --- Location Intelligence ---
GOOGLE_MAPS_API_KEY=your_google_maps_key
MAX_DISTANCE_KM=500

# --- Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Ops alerts (crawler anomalies/failures) ---
# Telegram: create a bot via @BotFather, get the token, and add the bot to
# the chat/group you want alerts in to get its chat ID.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Reuses the SMTP_* creds above, sent to this address instead of a user's inbox
OPS_ALERT_EMAIL=you@example.com

# --- Crawler ---
CRAWL_CRON="0 */6 * * *"
EXPIRE_CLEANUP_CRON="0 3 * * *"
API_DETECTION_CRON="0 6 * * 1"
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_DELAY_MS=1000
CRAWLER_TIMEOUT_MS=15000
CRAWLER_SOURCE_DELAY_MS=1500
# Minimum gap (ms) between two requests to the SAME host — prevents e.g. a
# static fetch + Puppeteer re-render hitting the same domain back-to-back.
CRAWLER_MIN_HOST_INTERVAL_MS=2000
# How long (ms) to suppress repeat alerts sharing the same dedupe key —
# stops a recurring break from re-alerting every single crawl run.
ALERT_COOLDOWN_MS=3600000
# Longer cooldown specifically for "possible API detected" alerts (weekly check)
API_ALERT_COOLDOWN_MS=604800000
# Hard wall-clock cap per source crawler (devpost/unstop/college) — if a
# crawler hangs for any reason beyond normal HTTP/nav timeouts, it's treated
# as failed rather than blocking the whole run indefinitely.
CRAWLER_SOURCE_TIMEOUT_MS=90000
# Explicit timeout for Google Geocoding API calls (previously had none)
GEOCODE_TIMEOUT_MS=8000
# Hard wall-clock cap for a single Puppeteer render, on top of page.goto's
# own navigation timeout
PUPPETEER_HARD_TIMEOUT_MS=45000

# --- API integration (Layer 0 — tried before HTML scraping) ---
# OFF by default. The URL/response-shape placeholders in devpostCrawler.js
# and unstopCrawler.js are UNVERIFIED — inspect the real API response
# yourself and correct itemsPath/fields before enabling either of these.
DEVPOST_API_ENABLED=false
DEVPOST_API_URL=https://devpost.com/api/hackathons
UNSTOP_API_ENABLED=false
UNSTOP_API_URL=https://unstop.com/api/public/opportunity/search
API_INTEGRATION_TIMEOUT_MS=10000
# How many consecutive API failures before the decision engine stops
# attempting the API layer and goes straight to scraping each run
STRATEGY_API_FAILURE_THRESHOLD=3
CRAWLER_DEVPOST_MIN_RESULTS=5
CRAWLER_UNSTOP_MIN_RESULTS=5
# AI fallback parsing is OFF by default — it costs an LLM call per source
# per run and is the slowest/most fragile layer. Only enable if selector
# breakage becomes a recurring problem.
CRAWLER_AI_FALLBACK_ENABLED=false
